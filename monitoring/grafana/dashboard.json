{
  "title": "Arbitrage Terminal",
  "uid": "arb-terminal-v1",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["arbitrage", "trading", "crypto"],
  "templating": {
    "list": [
      {
        "name": "exchange",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(arb_ws_connected, exchange)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "symbol",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(arb_spread_opportunities_total, symbol)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Реализованный PnL (USDT)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "arb_realized_pnl_usdt",
          "legendFormat": "PnL"
        },
        {
          "expr": "arb_peak_pnl_usdt",
          "legendFormat": "Peak PnL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0 },
              { "color": "green", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Просадка (%)",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "arb_drawdown_pct", "legendFormat": "Drawdown %" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 20,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 7 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Открытая позиция (USDT)",
      "type": "gauge",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "arb_exposure_usdt", "legendFormat": "Exposure" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "max": 10000
        }
      }
    },
    {
      "id": 4,
      "title": "Сделки в секунду",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(arb_trades_total{state=\"completed\"}[1m])",
          "legendFormat": "completed/s"
        },
        {
          "expr": "rate(arb_trades_total{state=\"failed\"}[1m])",
          "legendFormat": "failed/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "id": 5,
      "title": "Opportunities / Scans",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(arb_spread_opportunities_total{symbol=~\"$symbol\"}[1m])",
          "legendFormat": "opp/s {{symbol}}"
        },
        {
          "expr": "rate(arb_spread_scans_total[1m])",
          "legendFormat": "scans/s"
        }
      ]
    },
    {
      "id": 6,
      "title": "Распределение спредов (bps)",
      "type": "histogram",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(arb_spread_bps_bucket[5m])) by (le)",
          "legendFormat": "{{le}} bps",
          "format": "heatmap"
        }
      ]
    },
    {
      "id": 7,
      "title": "Execution latency (мс) — P50 / P95 / P99",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(arb_execution_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(arb_execution_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(arb_execution_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    },
    {
      "id": 8,
      "title": "WebSocket latency P95 (мкс)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(arb_ws_latency_us_bucket{exchange=~\"$exchange\"}[5m])) by (le, exchange))",
          "legendFormat": "{{exchange}} P95"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "µs" }
      }
    },
    {
      "id": 9,
      "title": "REST latency P95 (мкс)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(arb_rest_latency_us_bucket{exchange=~\"$exchange\"}[5m])) by (le, exchange, endpoint))",
          "legendFormat": "{{exchange}} {{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "µs" }
      }
    },
    {
      "id": 10,
      "title": "Watchdog — состояния воркеров",
      "type": "bargauge",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "arb_workers_total",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "failed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "disabled" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-red" } }]
          }
        ]
      }
    },
    {
      "id": 11,
      "title": "Exchange WebSocket — статус",
      "type": "stat",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "arb_ws_connected{exchange=~\"$exchange\"}",
          "legendFormat": "{{exchange}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "OFFLINE", "color": "red" }, "1": { "text": "ONLINE", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 12,
      "title": "Orderbook stale — количество",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 34, "w": 24, "h": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(arb_orderbook_stale) by (exchange)",
          "legendFormat": "{{exchange}} stale books"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    }
  ]
}
