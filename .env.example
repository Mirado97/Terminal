# Окружение: testnet | production
APP_ENV=testnet

# ---- Bybit Testnet ----
# Получить на: https://testnet.bybit.com -> Account -> API Management
BYBIT_API_KEY_TESTNET=your_key_here
BYBIT_API_SECRET_TESTNET=your_secret_here

# ---- Bybit Production ----
BYBIT_API_KEY=your_key_here
BYBIT_API_SECRET=your_secret_here

# ---- Binance Testnet ----
# Получить на: https://testnet.binance.vision -> Generate HMAC_SHA256 Key
BINANCE_API_KEY_TESTNET=your_key_here
BINANCE_API_SECRET_TESTNET=your_secret_here

# ---- Bitget Production ----
BITGET_API_KEY=your_key_here
BITGET_API_SECRET=your_secret_here
BITGET_PASSPHRASE=your_passphrase_here

# ---- Binance Production ----
BINANCE_API_KEY=your_key_here
BINANCE_API_SECRET=your_secret_here

# ---- MEXC Proxy (резидентный SOCKS5, Сингапур) ----
# Нужен для обхода Akamai WAF на VPS (POST-запросы блокируются датацентровыми IP)
# Формат: socks5://user:pass@host:port
# Если не задан — прокси не используется
MEXC_PROXY=

# ---- Storage ----
POSTGRES_URL=postgresql://arb:change_me@localhost:5432/arb
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=change_me

# ---- Grafana ----
GRAFANA_PASSWORD=change_me
